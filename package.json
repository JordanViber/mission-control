{
  "name": "mission-control",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "PORTS=\"4010 4000\" ./scripts/dev-prestart.sh && WATCHPACK_POLLING=true next dev -p 4010",
    "build": "next build",
    "start": "next start -p 4010",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "screenshot:deliverable": "node scripts/capture-deliverable-screenshot.mjs",
    "lint": "next lint",
    "db:seed": "tsx scripts/seed.ts",
    "db:checkpoint": "tsx scripts/checkpoint-db.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.12",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.21",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
